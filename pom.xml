<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.bootcamp</groupId>
        <artifactId>bootcamp-parent-pom</artifactId>
        <version>2.2.0</version>
        <relativePath/>
    </parent>

    <artifactId>account-service</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>account-service</name>
    <description>
        Cuentas bancarias (ahorro, corriente, plazo fijo): CRUD, depositos/retiros con saldo
        atomico e idempotencia, sobre accountdb. Valida el cliente contra customer-service via REST.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-mongodb-reactive</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-config</artifactId>
        </dependency>
        <!-- spring-retry + starter-aop: sin estos dos, spring.cloud.config.retry.enabled no
             hace nada (el interceptor de reintentos no se teje) - version manejada por los BOM
             heredados (spring-cloud-dependencies / spring-boot-starter-parent). -->
        <dependency>
            <groupId>org.springframework.retry</groupId>
            <artifactId>spring-retry</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-circuitbreaker-reactor-resilience4j</artifactId>
        </dependency>
        <!-- Cache de datos de cliente (D8, Fase III: "datos catalogados o maestros") - variante
             reactiva, coherente con Reactor de punta a punta (D1/D2). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis-reactive</artifactId>
        </dependency>
        <!-- Entrega 2 yanki-service (D8, Fase III): consume solicitudes de operacion de cuenta y
             publica el resultado, para la coreografia de transferencias entre monederos vinculados. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- reactor-test ya viene heredado de bootcamp-parent-pom -->
        <!-- Spring Boot 4 modularizo el test-autoconfigure monolitico por tecnologia (ver leccion
             aprendida en customer-service / CONVENTIONS.md). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webflux-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Contrato OpenAPI (Requerimiento no funcional Parte I/III) + Swagger UI: generado a
             partir de los controladores REST reales via @OpenAPIDefinition en la clase principal
             - /v3/api-docs y /swagger-ui.html. Version gestionada en bootcamp-parent-pom. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>account-service</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
